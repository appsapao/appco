<?xml version="1.0" encoding="utf-8"?>
<!--
  The app stores no user data that is worth backing up: signing keys and built
  APKs are regenerable, and copying the signing key into a cloud backup would be
  a liability. Backups and device-to-device transfer are therefore disabled.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
